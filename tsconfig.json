{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/engines/*": ["./src/engines/*"],
      "@/portals/*": ["./src/portals/*"],
      "@/app/*": ["./src/app/*"],
      "@/server/*": ["./server/*"],
      "@server/*": ["./server/*"]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "types": ["node", "vitest"],
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false
  }
}
