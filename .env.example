# -----------------------------------------------------------------------------
# AssessIQ / Examify Enterprise Environment Configuration Template
# DO NOT commit real production credentials to this file.
# Copy this file to .env and supply secure environment-specific values.
# -----------------------------------------------------------------------------

# Database (PostgreSQL)
POSTGRES_DB=examify_vanguard
POSTGRES_USER=examify_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://examify_admin:your_secure_postgres_password_here@postgres:5432/examify_vanguard

# Cache & Message Broker (Redis)
REDIS_URL=redis://redis:6379

# Server Security & Cryptography
# JWT_SECRET must be at least 32 characters long.
# Generate in Node via: crypto.randomBytes(48).toString('hex')
JWT_SECRET=your_jwt_secret_min_32_characters_here_generate_with_crypto
PORT=8080
NODE_ENV=development

# Client & CORS
CLIENT_ORIGIN=http://localhost:8080

